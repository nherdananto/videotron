generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Swap to "postgresql" + DATABASE_URL for staging/production; SQLite keeps local dev dependency-free.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum GameType {
  SPIN_WHEEL
  VOTING
  POLLING
  QUIZ
  TIC_TAC_TOE
  RACING
  INSTAGRAM_WALL
}

enum PrizeType {
  VOUCHER
  DISKON
  MERCHANDISE
  KUPON_BELANJA
  LUCKY_POINT
  NO_PRIZE
}

model Campaign {
  id        String         @id @default(cuid())
  slug      String         @unique
  name      String
  logoUrl   String?
  bannerUrl String?
  startAt   DateTime?
  endAt     DateTime?
  status    CampaignStatus @default(DRAFT)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  games           CampaignGame[]
  participants    Participant[]
  spinPrizes      SpinPrize[]
  spinResults     SpinResult[]
  votingQuestions VotingQuestion[]
  pollSessions    PollSession[]
}

// Which games are enabled for a campaign, and their per-game config (CMS: "pilih game yang akan dipasang").
model CampaignGame {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  gameType   GameType
  isActive   Boolean  @default(true)
  config     Json?

  @@unique([campaignId, gameType])
}

// Identity for a visitor within one campaign. Phone is the de-dup key enforcing "1x main per campaign".
model Participant {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  phone        String
  sessionToken String   @unique
  createdAt    DateTime @default(now())

  spinResults SpinResult[]
  voteEntries VoteEntry[]
  pollAnswers PollAnswer[]

  @@unique([campaignId, phone])
  @@index([campaignId])
}

model SpinPrize {
  id             String    @id @default(cuid())
  campaignId     String
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  label          String
  type           PrizeType
  probability    Float
  quota          Int?
  quotaRemaining Int?
  validFrom      DateTime?
  validUntil     DateTime?
  createdAt      DateTime  @default(now())

  spinResults SpinResult[]

  @@index([campaignId])
}

// One row per participant per campaign — enforces the "maksimal 1 kali bermain" acceptance criterion.
model SpinResult {
  id            String      @id @default(cuid())
  campaignId    String
  campaign      Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  prizeId       String?
  prize         SpinPrize?  @relation(fields: [prizeId], references: [id])
  isWin         Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@unique([campaignId, participantId])
}

// Only one question per campaign is isActive at a time — that's the one shown on videotron/mobile.
model VotingQuestion {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  question   String
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())

  options VotingOption[]
  votes   VoteEntry[]

  @@index([campaignId])
}

model VotingOption {
  id               String         @id @default(cuid())
  votingQuestionId String
  votingQuestion   VotingQuestion @relation(fields: [votingQuestionId], references: [id], onDelete: Cascade)
  label            String
  createdAt        DateTime       @default(now())

  votes VoteEntry[]

  @@index([votingQuestionId])
}

// One vote per participant per question — the de-dup key for "Vote dikirim" not being spammable.
model VoteEntry {
  id               String         @id @default(cuid())
  votingQuestionId String
  votingQuestion   VotingQuestion @relation(fields: [votingQuestionId], references: [id], onDelete: Cascade)
  votingOptionId   String
  votingOption     VotingOption   @relation(fields: [votingOptionId], references: [id], onDelete: Cascade)
  participantId    String
  participant      Participant    @relation(fields: [participantId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([votingQuestionId, participantId])
}

// A poll session groups several questions answered together in one sitting
// ("Polling mendukung beberapa pertanyaan dalam satu sesi"). Only one session
// per campaign is isActive at a time.
model PollSession {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title      String
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())

  questions PollQuestion[]

  @@index([campaignId])
}

model PollQuestion {
  id            String      @id @default(cuid())
  pollSessionId String
  pollSession   PollSession @relation(fields: [pollSessionId], references: [id], onDelete: Cascade)
  question      String
  order         Int         @default(0)
  createdAt     DateTime    @default(now())

  options PollOption[]
  answers PollAnswer[]

  @@index([pollSessionId])
}

model PollOption {
  id             String       @id @default(cuid())
  pollQuestionId String
  pollQuestion   PollQuestion @relation(fields: [pollQuestionId], references: [id], onDelete: Cascade)
  label          String
  createdAt      DateTime     @default(now())

  answers PollAnswer[]

  @@index([pollQuestionId])
}

// One answer per participant per question — a participant works through every
// question in the active session, unlike Voting's single always-on question.
model PollAnswer {
  id             String       @id @default(cuid())
  pollQuestionId String
  pollQuestion   PollQuestion @relation(fields: [pollQuestionId], references: [id], onDelete: Cascade)
  pollOptionId   String
  pollOption     PollOption   @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  participantId  String
  participant    Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([pollQuestionId, participantId])
}
