DATABASE_URL="file:./dev.db"
PORT=3000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-random-64-char-hex-string"

# Used only by `npm run db:seed` to bootstrap the first CMS admin account.
ADMIN_EMAIL="admin@videotron.local"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Admin"
